rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isLedgerMember(ledgerId) {
      return signedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.memberIds;
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /ledgers/{ledgerId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds;
      allow read, update: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read, create, update, delete: if isLedgerMember(ledgerId);
      }
    }
  }
}
