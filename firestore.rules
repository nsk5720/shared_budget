rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isLedgerMember(ledgerId) {
      return signedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/ledgers/$(ledgerId)).data.memberIds;
    }

    function isInvitationParticipant(invitation) {
      return signedIn()
        && (request.auth.uid == invitation.senderId
          || request.auth.uid == invitation.receiverId);
    }

    function isValidTransaction(transaction) {
      return transaction.keys().hasAll([
          'title',
          'category',
          'amount',
          'type',
          'date',
          'memo',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && transaction.keys().hasOnly([
          'title',
          'category',
          'amount',
          'type',
          'date',
          'memo',
          'createdBy',
          'createdAt',
          'updatedAt',
          'deletedAt',
          'deletedBy',
          'importedFromLedgerId',
          'importedFromTransactionId',
          'importedBy',
          'importedAt'
        ])
        && transaction.title is string
        && transaction.title.size() > 0
        && transaction.title.size() <= 100
        && transaction.category is string
        && transaction.category.size() > 0
        && transaction.category.size() <= 40
        && transaction.amount is int
        && transaction.amount > 0
        && transaction.amount <= 999999999999
        && transaction.type in ['expense', 'income']
        && transaction.date is timestamp
        && transaction.memo is string
        && transaction.memo.size() <= 5000
        && transaction.createdBy is string
        && (!transaction.keys().hasAny(['deletedAt'])
          || transaction.deletedAt is timestamp)
        && (!transaction.keys().hasAny(['deletedBy'])
          || transaction.deletedBy is string)
        && (!transaction.keys().hasAny(['importedFromLedgerId'])
          || transaction.importedFromLedgerId is string)
        && (!transaction.keys().hasAny(['importedFromTransactionId'])
          || transaction.importedFromTransactionId is string)
        && (!transaction.keys().hasAny(['importedBy'])
          || transaction.importedBy is string)
        && (!transaction.keys().hasAny(['importedAt'])
          || transaction.importedAt is timestamp);
    }

    function isValidPersonalLedger(ledgerId) {
      return ledgerId == 'personal_' + request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds.hasOnly([request.auth.uid]);
    }

    function isValidSharedLedger(ledgerId) {
      let invitationId = request.resource.data.sourceInvitationId;
      let invitation = getAfter(
        /databases/$(database)/documents/invitations/$(invitationId)
      ).data;
      return ledgerId == 'shared_' + invitationId
        && invitation.status == 'accepted'
        && invitation.sharedLedgerId == ledgerId
        && request.auth.uid == invitation.receiverId
        && request.resource.data.memberIds.size() == 2
        && request.resource.data.memberIds.hasOnly([
          invitation.senderId,
          invitation.receiverId
        ]);
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /inviteCodes/{inviteCode} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.status == 'pending'
        && get(
          /databases/$(database)/documents/inviteCodes/$(request.resource.data.senderInviteCode)
        ).data.userId == request.auth.uid
        && get(
          /databases/$(database)/documents/inviteCodes/$(request.resource.data.receiverInviteCode)
        ).data.userId == request.resource.data.receiverId;
      allow read: if isInvitationParticipant(resource.data);
      allow update: if signedIn()
        && request.auth.uid == resource.data.receiverId
        && resource.data.status == 'pending'
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'respondedAt',
          'sharedLedgerId'
        ])
        && request.resource.data.status in ['accepted', 'rejected']
        && (
          request.resource.data.status == 'rejected'
          || request.resource.data.sharedLedgerId == 'shared_' + invitationId
        );
      allow delete: if false;
    }

    match /ledgers/{ledgerId} {
      allow create: if signedIn()
        && (
          isValidPersonalLedger(ledgerId)
          || isValidSharedLedger(ledgerId)
        );
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read, delete: if isLedgerMember(ledgerId);
        allow create, update: if isLedgerMember(ledgerId)
          && isValidTransaction(request.resource.data);
      }
    }
  }
}
